RMS_ENV=development
RMS_APP_NAME=Room Management System
RMS_SECRET_KEY=change-me
RMS_DATABASE_URL=postgresql+psycopg://rms:rms@postgres:5432/rms
RMS_SESSION_COOKIE_NAME=rms_session
RMS_SESSION_SECURE=false
RMS_DEFAULT_TIMEZONE=Europe/Berlin
RMS_CORS_ORIGINS=http://localhost:3000
RMS_SUPPORTED_LANGUAGES=de,en,fr,pt,es,yo,sw
RMS_DEFAULT_LANGUAGE=de
RMS_BABEL_TRANSLATION_DIRECTORIES=translations
RMS_TRANSLATION_SOURCE_LANGUAGE=en

# Set to true and fill in the values below to use real SSO. Users must be
# pre-created and active before their first login -- the gate never
# auto-provisions. See docs/oidc_preapproved_user_gate_handoff.md.
RMS_OIDC_ENABLED=false
RMS_OIDC_SERVER_METADATA_URL=
RMS_OIDC_CLIENT_ID=
RMS_OIDC_CLIENT_SECRET=
RMS_OIDC_SCOPES=openid profile email
RMS_DEV_AUTH_ENABLED=true

RMS_REDIS_URL=redis://redis:6379/0

# Object storage (S3-compatible). Dev defaults target the local MinIO container.
RMS_S3_ENDPOINT_URL=http://minio:9000
RMS_S3_REGION=us-east-1
RMS_S3_ACCESS_KEY_ID=minioadmin
RMS_S3_SECRET_ACCESS_KEY=minioadmin
RMS_S3_BUCKET=rms-dev
RMS_S3_KEY_PREFIX=rms
RMS_S3_ADDRESSING_STYLE=path
# Production (Hetzner Object Storage) example — DO NOT use in dev:
#   RMS_S3_ENDPOINT_URL=https://<region>.your-objectstorage.com
#   RMS_S3_REGION=fsn1
#   RMS_S3_ACCESS_KEY_ID=<hetzner-access-key>
#   RMS_S3_SECRET_ACCESS_KEY=<hetzner-secret-key>
#   RMS_S3_BUCKET=your-bucket-name
#   RMS_S3_KEY_PREFIX=rms
#   RMS_S3_ADDRESSING_STYLE=virtual

RMS_DOCUMENT_URL_EXPIRE_SECONDS=900

RMS_NEXTCLOUD_SYNC_ENABLED=false
RMS_NEXTCLOUD_URL=
RMS_NEXTCLOUD_ADMIN_USER=
RMS_NEXTCLOUD_APP_PASSWORD=
RMS_NEXTCLOUD_OCS_VERSION=v2
RMS_NEXTCLOUD_TIMEOUT_S=30
RMS_NEXTCLOUD_PAGE_SIZE=100

# --- Outbound mail ---
# Disabled by default: RMS logs what it would have sent instead of needing a
# reachable SMTP server. Everything else works either way.
RMS_MAIL_ENABLED=false
RMS_MAIL_HOST=localhost
RMS_MAIL_PORT=587
RMS_MAIL_USERNAME=
RMS_MAIL_PASSWORD=
RMS_MAIL_USE_TLS=true
RMS_MAIL_USE_SSL=false
RMS_MAIL_FROM=no-reply@example.com
RMS_MAIL_FROM_NAME=
RMS_MAIL_REPLY_TO=
# Comma-separated. Who gets told about a new public booking request.
RMS_MAIL_ADMIN_RECIPIENTS=
RMS_MAIL_TIMEOUT_S=20

# How many reverse proxies sit in front of RMS.
#
# MUST be set before the public booking form is exposed. At 0 the client
# address is request.client.host, which behind a proxy is the proxy itself --
# every visitor then shares one rate-limit bucket, and the limiter becomes a
# denial of service against your own users. Set it to the number of trusted
# hops and run uvicorn with --proxy-headers; X-Forwarded-For is then read from
# that many entries in from the right, since the left-hand ones are
# attacker-controlled.
RMS_TRUSTED_PROXY_COUNT=0

# Absolute base for links in emails. A Celery worker has no request to derive
# a host from, so a manage link is unusable without this.
RMS_PUBLIC_BASE_URL=http://localhost:8001

# --- Member booking policy ---
# Internal bookings confirm instantly, so these bound what one account holder
# can take without any staff involvement.
RMS_MEMBER_BOOKING_MAX_HORIZON_DAYS=90
RMS_MEMBER_BOOKING_MAX_DURATION_HOURS=12

# --- Host port bindings ---
# Override any of these if a port is already in use on your machine.
RMS_API_PORT=8001
RMS_POSTGRES_PORT=5432
RMS_REDIS_PORT=6379
RMS_MINIO_PORT=9002
RMS_MINIO_CONSOLE_PORT=9003

# --- Branding ---
# Everything visitors see that names or styles the operating organisation.
# Nothing is hardcoded in templates; anything left empty renders nothing.
# See docs/branding.md.
RMS_BRAND_NAME=Room Booking
RMS_BRAND_LEGAL_NAME=
# Absolute URL, or a path under /static. Empty shows the name as text.
RMS_BRAND_LOGO_URL=
RMS_BRAND_WEBSITE_URL=
RMS_BRAND_PRIVACY_URL=
RMS_BRAND_IMPRINT_URL=
RMS_BRAND_CONTACT_EMAIL=
RMS_BRAND_CONTACT_PHONE=
# "Label|https://url;Label|https://url"
RMS_BRAND_FOOTER_LINKS=
# Letters scattered behind the public hero, e.g. ABC. Empty = no decoration.
RMS_BRAND_HERO_LETTERS=
# One hex value each; full 50-900 scales are generated at runtime.
RMS_BRAND_COLOR_PRIMARY=#3b4a6b
RMS_BRAND_COLOR_ACCENT=#f0b429
RMS_BRAND_COLOR_HIGHLIGHT=#5b3a7a
RMS_BRAND_COLOR_SURFACE=#f8fafc
RMS_BRAND_COLOR_FOOTER=#1e293b
RMS_BRAND_FONT_HEADING=Inter
RMS_BRAND_FONT_BODY=Inter
# Optional stylesheet that loads the fonts named above.
RMS_BRAND_FONT_CSS_URL=
