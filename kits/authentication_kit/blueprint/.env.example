POSTBUCH_ENV=development
POSTBUCH_APP_NAME=My New App
POSTBUCH_SECRET_KEY=replace-me
POSTBUCH_DATABASE_URL=postgresql+psycopg://myapp:myapp@db:5432/myapp
POSTBUCH_SESSION_COOKIE_NAME=myapp_session
POSTBUCH_OIDC_ENABLED=true
POSTBUCH_OIDC_SERVER_METADATA_URL=https://nextcloud.example.com/apps/sociallogin/custom_oidc/.well-known/openid-configuration
POSTBUCH_OIDC_CLIENT_ID=myapp
POSTBUCH_OIDC_CLIENT_SECRET=replace-me
POSTBUCH_OIDC_SCOPES=openid profile email
POSTBUCH_OIDC_ADMIN_EMAILS=admin@example.com
POSTBUCH_DEV_AUTH_ENABLED=false
